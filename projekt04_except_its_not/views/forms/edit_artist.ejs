<form action="/songs/edit/<%=artist.id%>" method="POST">
  <div>
    <label for="artist_name">Nazwa kategorii</label>
    <input
      type="text"
      name="artist"
      id="artist_name"
      required
      minlength="3"
      maxlength="100"
      <% if (locals.artist.name){ %>
      value="<%= artist.name %>"
      <% }%>
    />
  </div>
  <div>
    <button>Zapisz</button>
  </div>
</form>
