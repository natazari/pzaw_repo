<%- include("head.partial.ejs") %>

  <!-- <nav>
  <a href="/collections/">Powrót do reszty kolekcji</a>
  </nav> -->
  <h1><%= title %></h1>
  <a href="/collections/edit/<%= collection.id %>" class="action-link">Edytuj kolekcję</a>
  <% if (collection.artists && collection.artists.length > 0) { %>
    <ul id="collections">
      <% collection.artists.forEach(function(artist){ %>
      <li>
        <a href="/artists/<%= artist.id %>">
          <%= artist.artist_name %>
        </a>
      </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>W tej kolekcji nie ma jeszcze żadnych artystów. Dodaj kogoś poniżej.</p>
  <% } %>
  <div>
    <h3>Nowy artysta</h3>
    <%- include("forms/new_artist.ejs", { collection_id: collection.id }) %>
  </div>
</main>

<%- include("foot.partial.ejs") %>