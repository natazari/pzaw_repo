<%- include("head.partial.ejs") %>
<main>
  <nav>
    <a href="/collections/artists">Powrót do listy artystów</a>
  </nav>
  <h1><%= title %></h1>
  <div>
    <% if (locals.errors != null) {%>
    <ul id="errors">
      <% errors.forEach(function(error){ %>
      <li><%= error %></li>
      <% }) %>
    </ul>
    <% } %>
    <%- include("forms/edit_artist.ejs") %>
    <% if (locals.artists.songs && locals.artist.songs.length > 0) { %>
      <ul id="songs">
        <% collection.artist.songs.forEach(function(song){ %>
        <li>
          <%- include("forms/edit_artist.ejs", {song, artist}) %>
          <form class="artist-action" action="collections/artists/songs/delete/<%= song.id %>" method="POST">
            <button>Usuń</button>
          </form>
        </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>Artysta nie ma piosenek. Dodaj nowe poniżej.</p>
    <% } %>
  </div>
  <a href="collections/artists/view/<%= artist.id %>">Powrót</a>
</main>

<%- include("foot.partial.ejs") %>
