<%- include("head.partial.ejs") %>
<main>
  <nav>
    <a href="/collections">Powrót do listy kolekcji</a>
  </nav>
  <h1><%= title %></h1>
  <div>
    <% if (locals.errors != null) {%>
    <ul id="errors">
      <% errors.forEach(function(error){ %>
      <li><%= error %></li>
      <% }) %>
    </ul>
    <% } %>
    <%- include("forms/edit_collection.ejs") %>
    <% if (locals.collection.artists && locals.collection.artists.length > 0) { %>
      <ul id="collections">
        <% collection.artists.forEach(function(artist){ %>
        <li>
          <%- include("forms/edit_artist.ejs", {artist, collection}) %>
          <form action="/artists/delete/<%= artist.id %>" method="POST">
            <button>Usuń</button>
          </form>
        </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>W tej kolekcji nie ma żadnych artystów. Dodaj nowe poniżej.</p>
    <% } %>
  </div>
  <a href="/collections/<%= collection.id %>">Powrót</a>
</main>

<%- include("foot.partial.ejs") %>
