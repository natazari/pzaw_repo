<form action="/artists/new_artist" method="POST">
  <div>
    <label for="artist_name">Nazwa artysty</label>
    <input
      type="text"
      name="name"
      id="artist_name"
      required
      minlength="3"
      maxlength="100"
      <% if (locals.name){ %>
      value="<%= name %>"
      <% }%>
    />
  </div>
  <div>
    <button>Dodaj</button>
  </div>
</form>
