<form action="/collections/edit/<%=collection.id%>" method="POST">
  <div>
    <label for="collection_name">Nazwa kolekcji</label>
    <input
      type="text"
      name="name"
      id="collection_name"
      required
      minlength="3"
      maxlength="100"
      <% if (locals.collection.name){ %>
      value="<%= collection.name %>"
      <% }%>
    />
  </div>
  <div>
    <button>Zapisz</button>
  </div>
</form>
